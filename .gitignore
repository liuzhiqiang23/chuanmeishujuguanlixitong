frontend/node_modules/
frontend/admin/
frontend/dist/
frontend/.vite/

# ---------- Python ----------
__pycache__/
*.pyc
.venv/

# ---------- 日志与临时文件 ----------
*.log
log/
_boot.log
backend/log/

# ---------- 系统 / Office 临时 ----------
.DS_Store
Thumbs.db
~$*

# ---------- 运行期生成 ----------
frontend/_ui_test.*
frontend/test_*.mjs
_shots/

# ---------- 数据 / 密钥（不入源码仓） ----------
data/tmdb_key.txt
backend/src/main/resources/static/posters/

# local AI assistant config (Claude Code model router)
.claude/
data/_git_need_add.txt
data/_git_orphans.txt

# ---------- 换数据集作业新增（2026-09-20） ----------
# Kaggle 原始下载件：credits.csv 190MB 超 GitHub 100MB 硬限制，且可随时重新下载
data/new_source/
# 内网穿透二进制（52MB），可从官网重新下载
tools/cloudflared.exe

# 模型二进制文件可由 train_all.py 一键重训生成，不入库
# （用 models/* 而不是 models/：目录整体被排除时无法再放行其中单个文件）
algorithm/boxoffice_prediction/models/*
# 例外：推理元数据很小（2KB）且是在线预测的必需件，入库保证仓库自包含
!algorithm/boxoffice_prediction/models/feature_meta.json

# 推荐引擎的相似度矩阵缓存（recommend_api.py 首次运行自动生成，可删）
algorithm/movie_recommendation/cache/

# 数据库备份 dump（单份约 9MB，保留在本机作回滚用，不入库；
# 需要入库的历史备份是 sql/backup_vidio_mangage_db_20260922.sql）
sql/backup/*.sql

# 本机私有环境变量（密钥/密码），永不入库
local_env.cmd
