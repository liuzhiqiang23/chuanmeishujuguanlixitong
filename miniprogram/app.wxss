/* ============================================================
   全局主题：深空科幻风（Deep-Space Sci-Fi HUD）
   主霓虹  #00E5FF（青）   辅霓虹  #7B5CFF（紫）
   警示/价格 #FF4D6D（霓虹粉）
   面板    玻璃质感 rgba(18,28,62,0.72) + 霓虹描边
   ============================================================ */
page {
  /* 深空底：网格线 + 顶部星云渐变 */
  background:
    repeating-linear-gradient(0deg, rgba(0, 229, 255, 0.03) 0, rgba(0, 229, 255, 0.03) 2rpx, transparent 2rpx, transparent 140rpx),
    repeating-linear-gradient(90deg, rgba(0, 229, 255, 0.03) 0, rgba(0, 229, 255, 0.03) 2rpx, transparent 2rpx, transparent 140rpx),
    linear-gradient(180deg, #0B1230 0%, #070B18 100%);
  font-size: 28rpx;
  color: #E8F1FF;
}

/* ---- 玻璃卡片：全局通用 ---- */
.card {
  position: relative;
  background: rgba(18, 28, 62, 0.72);
  border: 1rpx solid rgba(0, 229, 255, 0.22);
  border-radius: 18rpx;
  padding: 24rpx;
  margin: 20rpx 24rpx;
  box-shadow:
    0 0 24rpx rgba(0, 229, 255, 0.08),
    0 10rpx 32rpx rgba(0, 0, 0, 0.45);
  overflow: hidden;
}

/* 卡片顶部一条霓虹光线 */
.card::before {
  content: "";
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 0;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(0, 229, 255, 0.85), rgba(123, 92, 255, 0.85), transparent);
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* ---- 标题：发光字 ---- */
.title {
  font-size: 32rpx;
  font-weight: 600;
  color: #F2F8FF;
  letter-spacing: 2rpx;
  text-shadow: 0 0 16rpx rgba(0, 229, 255, 0.45);
}

.muted {
  color: #7C89B8;
  font-size: 24rpx;
}

/* ---- 价格：霓虹粉 ---- */
.price {
  color: #FF4D6D;
  font-weight: 600;
  text-shadow: 0 0 14rpx rgba(255, 77, 109, 0.45);
}

/* ---- 通用霓虹按钮（供页面复用） ---- */
.btn-neon {
  background: linear-gradient(135deg, #00E5FF, #7B5CFF);
  color: #06091A;
  font-weight: 600;
  border-radius: 40rpx;
  box-shadow: 0 0 24rpx rgba(0, 229, 255, 0.35);
}

/* 深色描边按钮 */
.btn-ghost {
  background: rgba(0, 229, 255, 0.08);
  border: 1rpx solid rgba(0, 229, 255, 0.45);
  color: #00E5FF;
  border-radius: 40rpx;
}
