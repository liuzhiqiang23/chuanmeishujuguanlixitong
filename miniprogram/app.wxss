/* ============================================================
   全局主题：深空科幻风（Deep-Space Sci-Fi HUD）
   主霓虹  #00E5FF（青）   辅霓虹  #7B5CFF（紫）
   警示/价格 #FF4D6D（霓虹粉）
   面板    玻璃质感 rgba(18,28,62,0.72) + 霓虹描边
   ============================================================ */
page {
  /* 深空底：网格线 + 顶部星云渐变 */
  background:
    repeating-linear-gradient(0deg, rgba(0, 229, 255, 0.03) 0, rgba(0, 229, 255, 0.03) 2rpx, transparent 2rpx, transparent 140rpx),
    repeating-linear-gradient(90deg, rgba(0, 229, 255, 0.03) 0, rgba(0, 229, 255, 0.03) 2rpx, transparent 2rpx, transparent 140rpx),
    linear-gradient(180deg, #0B1230 0%, #070B18 100%);
  font-size: 28rpx;
  color: #E8F1FF;
}

/* ---- 玻璃卡片：全局通用 ---- */
.card {
  position: relative;
  background: rgba(18, 28, 62, 0.72);
  border: 1rpx solid rgba(0, 229, 255, 0.22);
  border-radius: 18rpx;
  padding: 24rpx;
  margin: 20rpx 24rpx;
  box-shadow:
    0 0 24rpx rgba(0, 229, 255, 0.08),
    0 10rpx 32rpx rgba(0, 0, 0, 0.45);
  overflow: hidden;
}

/* 卡片顶部一条霓虹光线 */
.card::before {
  content: "";
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 0;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(0, 229, 255, 0.85), rgba(123, 92, 255, 0.85), transparent);
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* ---- 标题：发光字 ---- */
.title {
  font-size: 32rpx;
  font-weight: 600;
  color: #F2F8FF;
  letter-spacing: 2rpx;
  text-shadow: 0 0 16rpx rgba(0, 229, 255, 0.45);
}

.muted {
  color: #7C89B8;
  font-size: 24rpx;
}

/* ---- 价格：霓虹粉 ---- */
.price {
  color: #FF4D6D;
  font-weight: 600;
  text-shadow: 0 0 14rpx rgba(255, 77, 109, 0.45);
}

/* ---- 通用霓虹按钮（供页面复用） ---- */
.btn-neon {
  background: linear-gradient(135deg, #00E5FF, #7B5CFF);
  color: #06091A;
  font-weight: 600;
  border-radius: 40rpx;
  box-shadow: 0 0 24rpx rgba(0, 229, 255, 0.35);
}

/* 深色描边按钮 */
.btn-ghost {
  background: rgba(0, 229, 255, 0.08);
  border: 1rpx solid rgba(0, 229, 255, 0.45);
  color: #00E5FF;
  border-radius: 40rpx;
}

/* ============================================================
   页面共用组件类（首页/分类/搜索等共用，必须放全局）
   ============================================================ */

/* 主按钮：霓虹渐变 */
.btn-primary {
  background: linear-gradient(135deg, #00E5FF, #7B5CFF);
  color: #06091A;
  font-weight: 600;
  border-radius: 44rpx;
  font-size: 30rpx;
  line-height: 84rpx;
  height: 84rpx;
  box-shadow: 0 0 24rpx rgba(0, 229, 255, 0.35);
}

.btn-primary[disabled] {
  background: #2A3358;
  color: #6B7699;
  box-shadow: none;
}

/* 小标签（如"观影券"）：霓虹芯片 */
.tag {
  display: inline-block;
  padding: 2rpx 14rpx;
  border-radius: 8rpx;
  background: rgba(0, 229, 255, 0.12);
  border: 1rpx solid rgba(0, 229, 255, 0.4);
  color: #00E5FF;
  font-size: 22rpx;
  margin-right: 10rpx;
  text-shadow: 0 0 10rpx rgba(0, 229, 255, 0.5);
}

.tag-red {
  background: rgba(255, 77, 109, 0.12);
  border-color: rgba(255, 77, 109, 0.45);
  color: #FF4D6D;
  text-shadow: 0 0 10rpx rgba(255, 77, 109, 0.5);
}

/* 列表海报缩略图 */
.poster {
  width: 140rpx;
  height: 200rpx;
  border-radius: 10rpx;
  background: rgba(0, 229, 255, 0.06);
  border: 1rpx solid rgba(0, 229, 255, 0.25);
}

.divider {
  height: 1rpx;
  background: rgba(0, 229, 255, 0.15);
  margin: 20rpx 0;
}

.empty {
  text-align: center;
  color: #6B7699;
  font-size: 26rpx;
  padding: 60rpx 0;
}

/* 底部固定操作条 */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(10, 16, 40, 0.96);
  border-top: 1rpx solid rgba(0, 229, 255, 0.22);
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.5);
}

/* 列表项右侧箭头 */
.chevron {
  margin-left: auto;
  padding-left: 16rpx;
  color: #4A5B8C;
  font-size: 42rpx;
  line-height: 1;
}

/* ---------- 影片列表项：首页/分类/搜索三页共用（flex 布局） ---------- */
.video-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(0, 229, 255, 0.12);
}

.video-item:last-child {
  border-bottom: none;
}

.video-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.video-name {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
  color: #F2F8FF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 管理员删除按钮：霓虹红描边，靠右与价格拉开 */
.del-btn {
  margin-left: auto;
  padding: 4rpx 22rpx;
  border: 1rpx solid #FF4D6D;
  border-radius: 26rpx;
  color: #FF4D6D;
  font-size: 24rpx;
  line-height: 1.6;
  box-shadow: 0 0 14rpx rgba(255, 77, 109, 0.3);
}

