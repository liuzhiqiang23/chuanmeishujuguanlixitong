/* 全局样式：和 movie-system 后台的蓝色主色调保持一致 */
page {
  background: #F5F6F8;
  font-size: 28rpx;
  color: #222222;
}

.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
}

.muted {
  color: #8A8F99;
  font-size: 24rpx;
}

.price {
  color: #E64545;
  font-weight: 600;
}

.btn-primary {
  background: #2F7FD1;
  color: #FFFFFF;
  border-radius: 44rpx;
  font-size: 30rpx;
  line-height: 84rpx;
  height: 84rpx;
}

.btn-primary[disabled] {
  background: #B9CDE3;
  color: #FFFFFF;
}

.btn-ghost {
  background: #FFFFFF;
  color: #2F7FD1;
  border: 2rpx solid #2F7FD1;
  border-radius: 44rpx;
  font-size: 28rpx;
}

.tag {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  background: #EEF4FB;
  color: #2F7FD1;
  font-size: 22rpx;
  margin-right: 10rpx;
}

.tag-red {
  background: #FDECEC;
  color: #E64545;
}

.poster {
  width: 140rpx;
  height: 200rpx;
  border-radius: 10rpx;
  background: #EDEDED;
}

.divider {
  height: 2rpx;
  background: #EEEEEE;
  margin: 20rpx 0;
}

.empty {
  text-align: center;
  color: #AAAAAA;
  font-size: 26rpx;
  padding: 60rpx 0;
}

.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 列表项右侧箭头：暗示整行可点进详情 */
.chevron {
  margin-left: auto;
  padding-left: 16rpx;
  color: #C8CDD4;
  font-size: 42rpx;
  line-height: 1;
}

/* ---------- 影片列表项：三个页面（首页/分类/搜索）共用，必须放全局 ----------
   教训：页面级 wxss 不共享，写进 index.wxss 的话分类页和搜索页拿不到样式，
   flex 布局会失效、退化成块级堆叠，海报占满整行、右边留一大片空白。 */
.video-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #F2F2F2;
}

.video-item:last-child {
  border-bottom: none;
}

.video-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.video-name {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 管理员的删除按钮：靠右对齐，跟价格拉开距离，别和箭头糊在一起 */
.del-btn {
  margin-left: auto;
  padding: 4rpx 22rpx;
  border: 1rpx solid #E55A5A;
  border-radius: 26rpx;
  color: #E55A5A;
  font-size: 24rpx;
  line-height: 1.6;
}
