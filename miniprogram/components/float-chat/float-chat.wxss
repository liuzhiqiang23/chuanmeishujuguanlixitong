/* 悬浮客服球：霓虹渐变，压在内容层之上；bottom 抬高避开拇指热区 */
.float-chat {
  position: fixed;
  right: 28rpx;
  bottom: 140rpx;
  z-index: 999;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx 16rpx 20rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, rgba(0, 229, 255, 0.16), rgba(123, 92, 255, 0.22));
  border: 1rpx solid rgba(0, 229, 255, 0.55);
  box-shadow: 0 0 18rpx rgba(0, 229, 255, 0.35);
  animation: fc-breath 2.4s ease-in-out infinite;
}

.float-chat:active {
  transform: scale(0.94);
}

.float-chat-icon {
  font-size: 34rpx;
  margin-right: 8rpx;
}

.float-chat-label {
  color: #00E5FF;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

@keyframes fc-breath {
  0%, 100% { box-shadow: 0 0 12rpx rgba(0, 229, 255, 0.25); }
  50% { box-shadow: 0 0 26rpx rgba(0, 229, 255, 0.55); }
}
