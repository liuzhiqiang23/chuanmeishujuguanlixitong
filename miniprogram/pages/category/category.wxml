<!-- 分类：顶部横向滚动的标签栏 + 该分类下的影片列表 -->
<view class="page">
  <scroll-view class="cate-bar" scroll-x="true" enable-flex="true" show-scrollbar="false">
    <view
      class="cate-item {{activeTagId === item.tagId ? 'cate-item-active' : ''}}"
      wx:for="{{categories}}" wx:key="tagId"
      data-id="{{item.tagId}}" data-name="{{item.tagName}}"
      bindtap="onTag">
      <text>{{item.tagName}}</text>
      <text class="cate-count">{{item.videoCount}}</text>
    </view>
  </scroll-view>

  <view class="card">
    <view class="row-between">
      <text class="title">{{activeName || '全部影片'}}</text>
      <text class="muted">{{status}}</text>
    </view>
    <view class="divider"></view>
    <view class="video-item" wx:for="{{videos}}" wx:key="videoId"
          data-id="{{item.videoId}}" bindtap="goDetail">
      <image class="poster" src="{{item.posterSrc}}" mode="widthFix" lazy-load
             data-src="{{item.posterSrc}}" catchtap="previewPoster"></image>
      <view class="video-info">
        <view class="video-name">{{item.videoName}}</view>
        <view class="muted">评分 {{item.voteAverage}} · 热度 {{item.popularity}}</view>
        <view class="row" style="margin-top:12rpx">
          <text class="tag">观影券</text>
          <text class="price">¥{{item.price}}</text>
          <text wx:if="{{isAdmin}}" class="del-btn"
                data-id="{{item.videoId}}" data-name="{{item.videoName}}"
                catchtap="removeVideo">删除</text>
          <text class="chevron">›</text>
        </view>
      </view>
    </view>
    <view class="empty" wx:if="{{videos.length === 0}}">{{loading ? '加载中...' : '这个分类下暂时没有影片'}}</view>
  </view>

  <view style="height:40rpx"></view>
</view>
