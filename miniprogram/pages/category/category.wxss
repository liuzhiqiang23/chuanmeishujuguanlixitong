/* 分类页：顶部横向标签栏（霓虹芯片） */
.cate-bar {
  white-space: nowrap;
  background: rgba(18, 28, 62, 0.72);
  border-bottom: 1rpx solid rgba(0, 229, 255, 0.18);
  padding: 18rpx 12rpx;
  margin-bottom: 16rpx;
}

.cate-item {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  margin: 0 8rpx;
  border-radius: 32rpx;
  background: rgba(0, 229, 255, 0.07);
  border: 1rpx solid rgba(0, 229, 255, 0.22);
  color: #9FB6E8;
  font-size: 26rpx;
}

.cate-item-active {
  background: linear-gradient(135deg, #00E5FF, #7B5CFF);
  color: #06091A;
  font-weight: 600;
  box-shadow: 0 0 20rpx rgba(0, 229, 255, 0.45);
}

.cate-count {
  margin-left: 8rpx;
  font-size: 20rpx;
  opacity: 0.75;
}
