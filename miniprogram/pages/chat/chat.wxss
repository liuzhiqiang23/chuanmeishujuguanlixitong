/* AI 客服：与小程序科幻配色一致 */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #070B18;
}

.chat-list {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}

.row-ai {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.row-me {
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
  margin-bottom: 24rpx;
}

.avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}

.avatar.ai {
  background: linear-gradient(135deg, #00E5FF, #2F7FD1);
  color: #06122A;
  font-weight: bold;
}

.avatar.me {
  background: #1C2750;
  color: #A8BEDC;
}

.bubble {
  max-width: 74%;
  padding: 20rpx 26rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  line-height: 1.55;
  word-break: break-all;
  white-space: pre-wrap;
}

.bubble.ai {
  background: #131A3A;
  color: #E7EFFB;
  border: 1rpx solid #24346B;
  border-top-left-radius: 6rpx;
  margin-left: 16rpx;
}

.bubble.me {
  background: linear-gradient(135deg, #00E5FF, #2F7FD1);
  color: #06122A;
  border-top-right-radius: 6rpx;
  margin-right: 16rpx;
}

.bubble .meta {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #6D7FA8;
}

.bubble.typing {
  color: #8CA2CC;
  animation: pulse 1.2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 0.55; }
  50% { opacity: 1; }
}

/* 建议追问 */
.suggest {
  white-space: nowrap;
  padding: 10rpx 24rpx;
}

.chip {
  display: inline-block;
  margin-right: 16rpx;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #9FE8FF;
  background: #101A3F;
  border: 1rpx solid #24346B;
}

/* 输入区 */
.input-bar {
  display: flex;
  align-items: center;
  padding: 18rpx 24rpx;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  background: #0B1026;
  border-top: 1rpx solid #1B2550;
}

.input {
  flex: 1;
  background: #131A3A;
  border: 1rpx solid #24346B;
  border-radius: 999rpx;
  padding: 16rpx 30rpx;
  color: #E7EFFB;
  font-size: 28rpx;
}

.send {
  margin-left: 18rpx;
  padding: 16rpx 38rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #00E5FF, #2F7FD1);
  color: #06122A;
  font-size: 28rpx;
  font-weight: bold;
}

.send-off {
  opacity: 0.4;
}
