/* 确认订单页：霓虹分隔 + 发光单选 */
.coupon-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(0, 229, 255, 0.14);
}

.coupon-row:last-child {
  border-bottom: none;
}

.radio {
  color: #00E5FF;
  font-size: 34rpx;
  text-shadow: 0 0 12rpx rgba(0, 229, 255, 0.55);
}

.submit-btn {
  width: 300rpx;
  margin: 0;
}
