/* 详情页：玻璃头部 + 霓虹海报框 */
.head {
  display: flex;
  padding: 30rpx 24rpx;
  background: rgba(18, 28, 62, 0.72);
  border-bottom: 1rpx solid rgba(0, 229, 255, 0.18);
}

.head-poster {
  width: 200rpx;
  height: 290rpx;
  border-radius: 12rpx;
  background: rgba(0, 229, 255, 0.06);
  border: 1rpx solid rgba(0, 229, 255, 0.4);
  box-shadow: 0 0 24rpx rgba(0, 229, 255, 0.25);
}

.head-info {
  flex: 1;
  margin-left: 24rpx;
}

.head-name {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
  color: #F2F8FF;
  text-shadow: 0 0 16rpx rgba(0, 229, 255, 0.45);
}

.overview {
  font-size: 27rpx;
  line-height: 44rpx;
  color: #AAB8DC;
}
