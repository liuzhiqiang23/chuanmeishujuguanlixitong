.member-bar {
  margin: 20rpx 24rpx;
  padding: 30rpx 28rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #2F7FD1, #4E9BE8);
  color: #FFFFFF;
}

.member-title {
  font-size: 34rpx;
  font-weight: 600;
}

.member-sub {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 8rpx;
}

.member-btn {
  background: #FFFFFF;
  color: #2F7FD1;
  font-size: 26rpx;
  padding: 10rpx 28rpx;
  border-radius: 40rpx;
}

.coupon-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #F2F2F2;
}

.coupon-item:last-child {
  border-bottom: none;
}

.coupon-left {
  width: 150rpx;
  text-align: center;
  border-right: 2rpx dashed #E5E5E5;
  margin-right: 20rpx;
}

.coupon-amount {
  color: #E64545;
  font-size: 40rpx;
  font-weight: 600;
}

.coupon-mid {
  flex: 1;
}

.coupon-btn {
  background: #E64545;
  color: #FFFFFF;
  font-size: 26rpx;
  padding: 10rpx 26rpx;
  border-radius: 40rpx;
}

/* 搜索入口 + 分类 */
.home-search {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx 0;
}

.home-search-box {
  flex: 1;
  display: flex;
  align-items: center;
  height: 72rpx;
  background: #FFFFFF;
  border-radius: 36rpx;
  padding: 0 28rpx;
}

.home-search-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
}

.home-search-hint {
  color: #9AA0A8;
  font-size: 28rpx;
}

.home-cate {
  margin-left: 18rpx;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: #FFFFFF;
  border-radius: 36rpx;
  color: #2F7FD1;
  font-size: 28rpx;
}

/* 分享领券 */
.share-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0 8rpx;
}

.share-text {
  color: #9AA0A8;
  font-size: 24rpx;
}

.share-btn {
  margin: 0;
  padding: 0 26rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 26rpx;
  color: #FFFFFF;
  background: #E55A5A;
  border-radius: 28rpx;
}

.share-btn::after {
  border: none;
}
