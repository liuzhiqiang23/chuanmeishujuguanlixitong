/* 首页：深空科幻风 */

/* 顶部会员横幅：青紫渐变 + 辉光 */
.member-bar {
  margin: 20rpx 24rpx;
  padding: 30rpx 28rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(0, 229, 255, 0.16), rgba(123, 92, 255, 0.22));
  border: 1rpx solid rgba(0, 229, 255, 0.35);
  box-shadow: 0 0 30rpx rgba(0, 229, 255, 0.18), 0 10rpx 30rpx rgba(0, 0, 0, 0.4);
  color: #EAF6FF;
}

.member-title {
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  text-shadow: 0 0 14rpx rgba(0, 229, 255, 0.6);
}

.member-sub {
  font-size: 24rpx;
  color: #9FB6E8;
  margin-top: 8rpx;
}

.member-btn {
  background: linear-gradient(135deg, #00E5FF, #7B5CFF);
  color: #06091A;
  font-size: 26rpx;
  font-weight: 600;
  padding: 10rpx 28rpx;
  border-radius: 40rpx;
  box-shadow: 0 0 20rpx rgba(0, 229, 255, 0.4);
}

/* 优惠券列表：霓虹分隔 */
.coupon-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(0, 229, 255, 0.14);
}

.coupon-item:last-child {
  border-bottom: none;
}

.coupon-left {
  width: 150rpx;
  text-align: center;
  border-right: 2rpx dashed rgba(0, 229, 255, 0.35);
  margin-right: 20rpx;
}

.coupon-amount {
  color: #FF4D6D;
  font-size: 40rpx;
  font-weight: 600;
  text-shadow: 0 0 14rpx rgba(255, 77, 109, 0.5);
}

.coupon-mid {
  flex: 1;
}

.coupon-btn {
  background: linear-gradient(135deg, #FF4D6D, #7B5CFF);
  color: #FFFFFF;
  font-size: 26rpx;
  padding: 10rpx 26rpx;
  border-radius: 40rpx;
  box-shadow: 0 0 18rpx rgba(255, 77, 109, 0.35);
}

/* 影片分类宫格：玻璃芯片 */
.cate-card {
  margin-bottom: 0;
}

.cate-more {
  padding: 8rpx 0 8rpx 20rpx;
}

.cate-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.cate-cell {
  width: 155rpx;
  margin: 0 10rpx 14rpx 0;
  padding: 18rpx 0 14rpx;
  text-align: center;
  background: rgba(0, 229, 255, 0.07);
  border: 1rpx solid rgba(0, 229, 255, 0.2);
  border-radius: 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cate-cell:nth-child(4n) {
  margin-right: 0;
}

.cate-cell:active {
  background: rgba(0, 229, 255, 0.18);
  box-shadow: 0 0 18rpx rgba(0, 229, 255, 0.35);
}

.cate-name {
  color: #00E5FF;
  font-size: 28rpx;
  font-weight: 600;
}

.cate-count {
  color: #7C89B8;
  font-size: 22rpx;
  margin-top: 4rpx;
}

/* 搜索入口 + 分类 */
.home-search {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx 0;
}

.home-search-box {
  flex: 1;
  display: flex;
  align-items: center;
  height: 72rpx;
  background: rgba(18, 28, 62, 0.72);
  border: 1rpx solid rgba(0, 229, 255, 0.28);
  border-radius: 36rpx;
  padding: 0 28rpx;
  box-shadow: 0 0 18rpx rgba(0, 229, 255, 0.1);
}

.home-search-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
  color: #00E5FF;
}

.home-search-hint {
  color: #7C89B8;
  font-size: 28rpx;
}

.home-cate {
  margin-left: 18rpx;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: rgba(0, 229, 255, 0.1);
  border: 1rpx solid rgba(0, 229, 255, 0.4);
  border-radius: 36rpx;
  color: #00E5FF;
  font-size: 28rpx;
}

/* 分享领券 */
.share-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0 8rpx;
}

.share-text {
  color: #7C89B8;
  font-size: 24rpx;
}

.share-btn {
  margin: 0;
  padding: 0 26rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 26rpx;
  color: #FFFFFF;
  background: linear-gradient(135deg, #FF4D6D, #7B5CFF);
  border-radius: 28rpx;
  box-shadow: 0 0 16rpx rgba(255, 77, 109, 0.35);
}

.share-btn::after {
  border: none;
}
