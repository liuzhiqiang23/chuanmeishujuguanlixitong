/* 会员页：深紫星云 + 金色霓虹 */
.member-bar {
  margin: 20rpx 24rpx;
  padding: 34rpx 28rpx;
  border-radius: 18rpx;
  background:
    radial-gradient(120% 160% at 85% 0%, rgba(123, 92, 255, 0.35), transparent 55%),
    linear-gradient(135deg, rgba(10, 14, 40, 0.9), rgba(42, 27, 94, 0.9));
  border: 1rpx solid rgba(246, 227, 180, 0.4);
  box-shadow: 0 0 30rpx rgba(123, 92, 255, 0.25), 0 10rpx 30rpx rgba(0, 0, 0, 0.45);
  color: #F6E3B4;
}

.member-title {
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  text-shadow: 0 0 16rpx rgba(246, 227, 180, 0.55);
}

.member-sub {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 10rpx;
}

.plan {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border: 1rpx solid rgba(0, 229, 255, 0.2);
  background: rgba(0, 229, 255, 0.04);
  border-radius: 14rpx;
  margin-bottom: 16rpx;
}

.plan-active {
  border-color: rgba(0, 229, 255, 0.8);
  background: rgba(0, 229, 255, 0.1);
  box-shadow: 0 0 22rpx rgba(0, 229, 255, 0.3);
}

.plan-name {
  font-size: 30rpx;
  font-weight: 600;
}

.plan-price {
  text-align: right;
}

.coupon-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(0, 229, 255, 0.14);
}

.coupon-row:last-child {
  border-bottom: none;
}

.radio {
  color: #00E5FF;
  font-size: 34rpx;
  text-shadow: 0 0 12rpx rgba(0, 229, 255, 0.55);
}

.pay-btn {
  width: 300rpx;
  margin: 0;
}
