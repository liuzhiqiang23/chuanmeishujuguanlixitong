/* 搜索页：搜索栏 + 历史标签云（玻璃质感） */
.search-bar {
  display: flex;
  align-items: center;
  background: rgba(18, 28, 62, 0.72);
  border-bottom: 1rpx solid rgba(0, 229, 255, 0.18);
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  background: rgba(0, 229, 255, 0.07);
  border: 1rpx solid rgba(0, 229, 255, 0.28);
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #E8F1FF;
}

.search-btn {
  margin-left: 20rpx;
  color: #00E5FF;
  font-size: 30rpx;
  font-weight: 600;
  padding: 0 8rpx;
  text-shadow: 0 0 12rpx rgba(0, 229, 255, 0.55);
}

.history-wrap {
  display: flex;
  flex-wrap: wrap;
  padding-top: 8rpx;
}

.history-tag {
  padding: 12rpx 26rpx;
  margin: 12rpx 16rpx 0 0;
  background: rgba(0, 229, 255, 0.07);
  border: 1rpx solid rgba(0, 229, 255, 0.22);
  border-radius: 32rpx;
  color: #9FB6E8;
  font-size: 26rpx;
}

